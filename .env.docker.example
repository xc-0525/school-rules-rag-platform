# ============================================================================
# Docker Compose 部署环境变量模板
# 使用方法：
#   1) 复制本文件为 .env（在项目根目录，和 docker-compose.yml 同级）
#   2) 填好 DEEPSEEK_API_KEY、MYSQL_ROOT_PASSWORD
#   3) .env 已被 .gitignore 忽略，不要提交
# ============================================================================

# DeepSeek（必填）
DEEPSEEK_API_KEY=sk-REPLACE_ME

# MySQL root 密码（必填；建议只用字母数字，避免 URL 转义问题）
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# 宿主机对外 HTTP 端口：本地测试可用 8080；公网服务器建议 80
HTTP_PORT=8080

# 登录鉴权：1=必须登录（公网必须为 1；0 需要同时 DEV_MODE=1，仅限本地）
AUTH_REQUIRED=1

# token 签名密钥（公网部署必填）：不填的话每次重启/每个 worker 的密钥都不同，
# 表现为"登录成功但下一个请求 401"。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 注意：原样保留占位符（CHANGE_ME_* / 长度不足 32 字节）会在启动时被拒绝。
AUTH_TOKEN_SECRET=CHANGE_ME_RANDOM_32_BYTES

# 限流与配额（公网部署建议保持开启）
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300
RATE_LIMIT_CONCURRENT=1

# token 有效期（秒）。公网建议 7200（2 小时）：缩短"token 被盗后仍可用"的窗口；
# P0-3 已支持用户级吊销，禁用/改密不再依赖自然过期
AUTH_TOKEN_TTL=7200

# 学生自助注册：1=开放，0=关闭
ALLOW_REGISTRATION=1

# 首启账号种子（P0-4）：仓库不再内嵌口令哈希，admin/student 由容器首启 seed 脚本创建。
# 留空 = 生成随机口令并在启动日志打印一次（请立即登录修改）；
# 填入 = 必须 ≥10 位且不得为已知弱口令（admin123 等），否则 seed 拒绝执行。
INIT_ADMIN_PASSWORD=
INIT_STUDENT_PASSWORD=

# 国内服务器下载 HuggingFace 模型可换成镜像
# HF_ENDPOINT=https://hf-mirror.com
