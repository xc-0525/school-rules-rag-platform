# ============================================================================
# Docker Compose 部署环境变量模板
# 使用方法：
#   1) 复制本文件为 .env（在项目根目录，和 docker-compose.yml 同级）
#   2) 填好 DEEPSEEK_API_KEY、MYSQL_ROOT_PASSWORD
#   3) .env 已被 .gitignore 忽略，不要提交
# ============================================================================

# DeepSeek（必填）
DEEPSEEK_API_KEY=sk-REPLACE_ME

# MySQL root 密码（必填；建议只用字母数字，避免 URL 转义问题）
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# 宿主机对外 HTTP 端口：本地测试可用 8080；公网服务器建议 80
HTTP_PORT=8080

# 登录鉴权：1=必须登录（公网建议开启），0=允许匿名
AUTH_REQUIRED=1

# 学生自助注册：1=开放，0=关闭
ALLOW_REGISTRATION=1

# 国内服务器下载 HuggingFace 模型可换成镜像
# HF_ENDPOINT=https://hf-mirror.com
