# ============================================================================
# Docker Compose 部署环境变量模板
# 使用方法：
#   1) 复制本文件为 .env（在项目根目录，和 docker-compose.yml 同级）
#   2) 填好 DEEPSEEK_API_KEY、MYSQL_ROOT_PASSWORD
#   3) .env 已被 .gitignore 忽略，不要提交
# ============================================================================

# DeepSeek（必填）
DEEPSEEK_API_KEY=sk-REPLACE_ME

# MySQL root 密码（必填；建议只用字母数字，避免 URL 转义问题）
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# 宿主机对外 HTTP 端口：本地测试可用 8080；公网服务器建议 80
HTTP_PORT=8080

# 登录鉴权：1=必须登录（公网必须为 1；0 需要同时 DEV_MODE=1，仅限本地）
AUTH_REQUIRED=1

# token 签名密钥（公网部署必填）：不填的话每次重启/每个 worker 的密钥都不同，
# 表现为"登录成功但下一个请求 401"。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_TOKEN_SECRET=CHANGE_ME_RANDOM_32_BYTES

# 限流与配额（公网部署建议保持开启）
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300
RATE_LIMIT_CONCURRENT=1

# 学生自助注册：1=开放，0=关闭
ALLOW_REGISTRATION=1

# 国内服务器下载 HuggingFace 模型可换成镜像
# HF_ENDPOINT=https://hf-mirror.com
