# ============================================================================
# 校纪校规问答平台 · 极简版主循环 环境变量模板
# 使用方法：复制本文件为 .env，然后填入自己的 DeepSeek API Key
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要把它提交到 Git 仓库。
# ============================================================================

# ---------- DeepSeek 大模型（必填） ----------
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容的接口地址；使用官方服务保持默认即可，走中转/代理时再改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型：deepseek-chat（通用对话，速度快、价格低）
DEEPSEEK_MODEL=deepseek-chat

# ---------- 生成参数（可选，一般无需修改） ----------
# 校规问答要稳定、可复现，温度建议 0.1 ~ 0.3
LLM_TEMPERATURE=0.2
# 单次请求超时时间（秒）
LLM_TIMEOUT_SECONDS=60
