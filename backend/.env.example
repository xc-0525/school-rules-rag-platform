# ============================================================================
# 校纪校规问答平台 · 环境变量模板
# 使用方法：复制本文件为 .env，然后填入自己的 DeepSeek API Key
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要把它提交到 Git 仓库。
# ============================================================================

# ---------- DeepSeek 大模型（必填） ----------
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容的接口地址；使用官方服务保持默认即可，走中转/代理时再改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型：deepseek-chat（通用对话，速度快、价格低）
DEEPSEEK_MODEL=deepseek-chat

# ---------- 生成参数（可选，一般无需修改） ----------
# 校规问答要稳定、可复现，温度建议 0.1 ~ 0.3
LLM_TEMPERATURE=0.2
# 单次请求超时时间（秒）
LLM_TIMEOUT_SECONDS=60

# ============================================================================
# v2 正式工程（backend/app）配置
# 默认值全部是 mock：不装任何数据库也能跑通带 Agent 轨迹的完整问答。
# ============================================================================

# ---- 适配器开关 ----
# mock | qdrant（qdrant 支持本地嵌入式模式，无需 Docker）
VECTOR_MODE=mock
# mock | neo4j
GRAPH_MODE=mock
# deepseek | fake（fake 用确定性假模型，适合离线测试 / 演示兜底）
LLM_MODE=deepseek

# ---- Agent 图编排参数 ----
MAX_STEPS=24
MAX_RETRIEVAL_ROUNDS=2
MAX_REGEN=1
EVIDENCE_THRESHOLD=0.5
NODE_TIMEOUT=120

# ---- MySQL（Day2 启用，本机 root 无密码可直接用）----
MYSQL_URL=mysql+pymysql://root:@127.0.0.1:3306/school_rules_rag?charset=utf8mb4

# ---- Qdrant（Day2 启用）----
# 本地嵌入式模式：填一个本地目录（真 Qdrant 引擎，不需要 Docker）
QDRANT_PATH=./data/qdrant
# 如果启动的是 Qdrant 服务，填 URL 并留空 QDRANT_PATH 即可
QDRANT_URL=

# ---- Neo4j（Day5 启用；本机已有 Java17，可跑 Community 版）----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
