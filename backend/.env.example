# ============================================================================
# 校纪校规问答平台 · 环境变量模板
# 使用方法：复制本文件为 .env，然后填入自己的 DeepSeek API Key
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要把它提交到 Git 仓库。
# ============================================================================

# ---------- DeepSeek 大模型（必填） ----------
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容的接口地址；使用官方服务保持默认即可，走中转/代理时再改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型：deepseek-chat（通用对话，速度快、价格低）
DEEPSEEK_MODEL=deepseek-chat

# ---------- 生成参数（可选，一般无需修改） ----------
# 校规问答要稳定、可复现，温度建议 0.1 ~ 0.3
LLM_TEMPERATURE=0.2
# 单次请求超时时间（秒）
LLM_TIMEOUT_SECONDS=60

# ============================================================================
# v2 正式工程（backend/app）配置
# 默认值全部是 mock：不装任何数据库也能跑通带 Agent 轨迹的完整问答。
# ============================================================================

# ---- 适配器开关 ----
# mock | qdrant（qdrant 支持本地嵌入式模式，无需 Docker）
VECTOR_MODE=mock
# mock | neo4j
GRAPH_MODE=mock
# deepseek | fake（fake 用确定性假模型，适合离线测试 / 演示兜底）
LLM_MODE=deepseek
# 登录鉴权：1=所有业务接口必须带 Bearer token（现场演示建议开启）；
# 0=允许匿名（本地 mock / 测试 / curl 兜底）
AUTH_REQUIRED=0

# ---- Agent 图编排参数 ----
MAX_STEPS=24
MAX_RETRIEVAL_ROUNDS=2
MAX_REGEN=1
EVIDENCE_THRESHOLD=0.5
NODE_TIMEOUT=120

# ---- MySQL（Day2 启用，本机 root 无密码可直接用）----
MYSQL_URL=mysql+pymysql://root:@127.0.0.1:3306/school_rules_rag?charset=utf8mb4

# ---- Qdrant + BGE（Day2 启用；全部复用本机已有环境，不需要 Docker、不需要下载模型）----
# 本地嵌入式模式：填一个本地目录（真 Qdrant 引擎，数据落盘）
QDRANT_PATH=./data/qdrant
# 如果启动的是 Qdrant 服务，填 URL 并留空 QDRANT_PATH 即可
QDRANT_URL=
QDRANT_COLLECTION=rules_chunks
# 本机已缓存的 bge-small-zh-v1.5（512 维），换机器时改成自己的路径
EMBEDDING_MODEL_PATH=G:\ai-models\hf\hub\models--BAAI--bge-small-zh-v1.5\snapshots\7999e1d3359715c523056ef9478215996d62a620

# ---- Neo4j（Day5 启用；本机 G:\neo4j 原生 5.26.30，auth 已关闭，不需要用户名密码）----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=
NEO4J_PASSWORD=
